{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(* gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(* gh api *pulls/*/merge*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(*enablePullRequestAutoMerge*)",
      "Bash(*mergePullRequest*)",
      "Bash(gh pr ready *)",
      "Bash(gh variable *)",
      "Bash(gh api *actions/variables*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh secret *)",
      "Bash(*agent:plan-ok*)",
      "Bash(*agent:hold*)",
      "Bash(*agent:auto-merge-stopped*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run agent *)",
      "Bash(node harness/scripts/agent.ts *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)"
    ]
  }
}
