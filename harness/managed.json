{
  "$comment": "導入先に配るファイルの一覧（Issue #155）。managed は sync が上書きする kit のもの、projectOwned は初回だけ雛形から作る導入先のもの、settingsKeys は .claude/settings.json のうちハーネスが持つキー（混ぜ方は sync の Issue で決める）。harness/test・package.json・tsconfig.json は配らない（ゲートは依存なしで Node 24 だけで動く）。exclude は managed に当たっても配らないもの（このリポジトリ専用の観測系）。sync は写さない。settingsAllow は permissions.allow に足す行（和集合。導入先の行は残し、kit の settings の allow は配らない）",
  "managed": [
    "harness/lib/**",
    "harness/gates/**",
    "harness/scripts/**",
    "harness/templates/**",
    "harness/CLAUDE.harness.md",
    ".claude/skills/**",
    ".claude/agents/**",
    ".claude/hooks/**",
    ".claude/routine.md",
    ".github/workflows/gate.yml",
    ".github/ISSUE_TEMPLATE/agent-task.yml",
    ".github/pull_request_template.md"
  ],
  "exclude": [
    "harness/scripts/observe.ts",
    "harness/scripts/test-prune.ts",
    "harness/scripts/test-prune-loop.ts",
    "harness/scripts/qa-retro-loop.ts",
    "harness/scripts/mutate.ts",
    "harness/scripts/patrol.ts",
    "harness/scripts/jev-language.ts",
    "harness/lib/observe.ts",
    "harness/lib/observe-docs.ts",
    "harness/lib/hotspot.ts",
    "harness/lib/test-prune.ts",
    "harness/lib/test-prune-loop.ts",
    "harness/lib/patrol.ts",
    "harness/lib/patrol-issue.ts",
    "harness/lib/arch-review.ts",
    "harness/lib/qa-retro-loop.ts",
    "harness/scripts/agent/commands/arch-review.ts",
    "harness/scripts/agent/commands/qa-retro.ts",
    "harness/scripts/agent/commands/patrol-issue.ts",
    ".claude/skills/arch-review/**",
    ".claude/skills/qa-retro/**",
    ".claude/skills/test-prune/**",
    ".claude/skills/patrol/**",
    ".claude/agents/arch-reviewer.md"
  ],
  "projectOwned": [
    {
      "path": "harness.config.json",
      "template": "harness/templates/harness.config.json"
    },
    {
      "path": "CLAUDE.md",
      "template": "harness/templates/CLAUDE.template.md"
    }
  ],
  "settingsKeys": [
    "permissions.deny",
    "permissions.disableBypassPermissionsMode",
    "hooks",
    "permissions.allow"
  ],
  "settingsAllow": [
    "Bash(node harness/scripts/agent.ts *)",
    "Bash(gh issue view *)",
    "Bash(gh pr view *)",
    "Bash(gh pr diff *)"
  ]
}
