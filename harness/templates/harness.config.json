{
  "$comment": "導入先の harness.config.json の雛形（harness/managed.json の projectOwned。初回だけ写し、以後は導入先が持つ）。書き換える場所：appSlug（setup.ts app-convert が書く）、projectChecks（導入先の CI のチェック名）、guardrailPaths（ハーネスが配るものに加え、導入先で Agent を縛る仕組みがあれば足す）、classification.areas（導入先の領域）、classification.priorityCriteria（Jev に priority を問うときの段階ごとの基準。導入先の仕事に合わせて英文で書く）、humanMergePaths（認証・マイグレーション・課金など、必ず人が Merge するパス）。それ以外は既定値のままでよい（delegateMergeExclude は自動 Merge の仕組みそのものを委任承認（計画・Merge とも）から守る一覧なので、減らさない）。requireAssignee は、複数人で開発するときに true にすると、Assignee がちょうど1人で自分の Issue（と、それを Close する PR）にだけ着手する（アサインは人が決める。既定は false）",
  "appSlug": "",
  "defaultBranch": "main",
  "agentBranchPrefix": "claude/",
  "mergeMethod": "SQUASH",
  "projectChecks": [
    {
      "context": "ci"
    }
  ],
  "requireAssignee": false,
  "routine": {
    "maxItemsPerRun": 5,
    "humanClaimStaleHours": 6,
    "routineClaimTakeoverMinutes": 90
  },
  "testPatterns": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**"
  ],
  "guardrailPaths": [
    "harness/lib/**",
    "harness/gates/**",
    "harness/scripts/**",
    "harness/templates/**",
    "harness/CLAUDE.harness.md",
    ".claude/skills/**",
    ".claude/agents/**",
    ".claude/hooks/**",
    ".claude/routine.md",
    ".github/workflows/gate.yml",
    ".github/ISSUE_TEMPLATE/agent-task.yml",
    "harness.config.json",
    "CLAUDE.md",
    ".claude/settings.json"
  ],
  "guardrailExclude": [
    "harness/lib/usage.ts",
    "harness/lib/classify.ts",
    "harness/lib/worktree.ts",
    "harness/lib/issue-triage.ts",
    "harness/lib/queue.ts",
    "harness/lib/concurrency.ts"
  ],
  "areaConcurrency": {
    "harness": 3
  },
  "fixLoop": {
    "normalLimit": 2,
    "criticalLimit": 3
  },
  "staleHours": 24,
  "dashboardIssueTitle": "Agent ダッシュボード",
  "reviewPanel": {
    "mode": "shadow"
  },
  "fleet": {
    "nesting": "orca",
    "maxParallelShips": 3
  },
  "jev": {
    "mode": "shadow",
    "model": "jev-1.13.0",
    "maxDiffChars": 80000,
    "decisionRelease": "shadow",
    "testTamper": "shadow",
    "thresholds": {
      "lowProbability": 0.9,
      "noulSafe": 0.9,
      "labelProbability": 0.8,
      "labelProbabilityByLabel": { "priority:medium": 0.5 },
      "decisionProbability": 0.9,
      "testTamperProbability": 0.9
    }
  },
  "autoMergeStopLabel": "agent:auto-merge-stopped",
  "humanMergePaths": [],
  "delegate": {
    "planLabel": "agent:delegate-plan",
    "mergeLabel": "agent:delegate-merge"
  },
  "delegateMergeExclude": [
    "harness/lib/merge-route.ts",
    "harness/lib/verdict.ts",
    "harness/lib/config.ts",
    "harness/lib/delegate.ts",
    "harness/gates/**",
    ".github/**",
    "harness.config.json",
    ".claude/settings.json",
    ".claude/hooks/**",
    ".claude/agents/reviewer.md",
    ".claude/agents/risk-agent.md",
    ".claude/skills/judge/SKILL.md",
    "docs/risk-policy.md"
  ],
  "classification": {
    "sizes": [
      [
        "XS",
        10
      ],
      [
        "S",
        30
      ],
      [
        "M",
        100
      ],
      [
        "L",
        500
      ],
      [
        "XL",
        1000
      ]
    ],
    "sizeExclude": [
      "package-lock.json",
      "**/*.lock",
      "**/*.snap"
    ],
    "areas": {
      "harness": [
        "harness/**",
        ".github/**",
        ".claude/**",
        "CLAUDE.md",
        "harness.config.json"
      ]
    },
    "issueTriage": "label",
    "priorityCriteria": {
      "highest": "Emergency: security, data loss, a broken main branch, or everything else is blocked on it. Drop other work.",
      "high": "Urgent: blocks users or other planned work; should be done before regular work.",
      "medium": "Regular planned work.",
      "low": "Nice to have; can wait until there is spare capacity.",
      "lowest": "Someday: only if nothing else is waiting."
    }
  },
  "pricing": {
    "$comment": "推定料金用の単価（100 万トークンあたり USD）。2026-09 時点の推定値なので、改定されたら更新する。キーはモデル ID（完全一致、無ければ前方一致）。",
    "claude-sonnet-5": {
      "input": 2,
      "output": 10,
      "cacheWrite5m": 2.5,
      "cacheWrite1h": 4,
      "cacheRead": 0.2
    },
    "claude-opus-5-5": {
      "input": 4,
      "output": 20,
      "cacheWrite5m": 5,
      "cacheWrite1h": 8,
      "cacheRead": 0.2
    },
    "claude-opus-5": {
      "input": 5,
      "output": 25,
      "cacheWrite5m": 6.25,
      "cacheWrite1h": 10,
      "cacheRead": 0.5
    },
    "claude-fable-5-1": {
      "input": 10,
      "output": 50,
      "cacheWrite5m": 12.5,
      "cacheWrite1h": 20,
      "cacheRead": 0.25
    },
    "claude-haiku-4-5": {
      "input": 1,
      "output": 5,
      "cacheWrite5m": 1.25,
      "cacheWrite1h": 2,
      "cacheRead": 0.1
    }
  }
}
