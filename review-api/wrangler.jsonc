{
  // PR レビューの試作の Worker の設定。デプロイは Cloudflare の Workers Builds（main への push）。docs/review-api.md の節 8.2・10
  "name": "gen-ai-development-kit-review-api",
  // src/worker.ts は #865 で作る
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workflows": [
    { "name": "review-workflow", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  "kv_namespaces": [
    // 人が 2026-10-12 に作った KV（docs/review-api.md の節8.2）
    { "binding": "REVIEW_KV", "id": "03092b8601b34de8800ff563881df28e" }
  ]
}
