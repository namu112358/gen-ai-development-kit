{
  // PR レビューの試作の Worker の設定。デプロイは人が docs/review-api.md の手順で行う。
  "name": "review-api",
  // src/worker.ts は #865 で作る
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workflows": [
    { "name": "review-workflow", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  "kv_namespaces": [
    // id は人が docs/review-api.md の節8.2 の `wrangler kv namespace create` の出力で埋める
    { "binding": "REVIEW_KV", "id": "" }
  ],
  "vars": {
    // GitHub App の Client ID
    "GITHUB_APP_CLIENT_ID": "",
    // GitHub App のインストール先の installation id
    "GITHUB_INSTALLATION_ID": "",
    // レビューの対象にするリポジトリ（owner/repo をカンマ区切り）
    "ALLOWED_REPOS": ""
  }
}
