# wrangler dev 用の値の雛形（秘密と、Cloudflare では Secret に入れる値）。`cp .dev.vars.example .dev.vars` で作り、値を入れる（.dev.vars は commit しない）
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
ANTHROPIC_API_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_INSTALLATION_ID=
ALLOWED_REPOS=
REVIEW_APP_LOGIN=
GATE_APP_LOGIN=
# 1 なら Claude を呼ばず固定の JSON を使う（実 API で試すときは消す）
DRY_RUN=1
