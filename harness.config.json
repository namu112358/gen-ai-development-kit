{
  "$comment": "導入先ごとの設定。Routine と Actions の両方が既定ブランチのこのファイルを読む。",
  "appSlug": "namu112358-agent-gate",
  "defaultBranch": "main",
  "agentBranchPrefix": "claude/",
  "mergeMethod": "SQUASH",
  "routine": {
    "maxItemsPerRun": 3,
    "humanClaimStaleHours": 6,
    "routineClaimTakeoverMinutes": 90
  },
  "fixLoop": {
    "normalLimit": 2,
    "criticalLimit": 3
  },
  "staleHours": 24,
  "dashboardIssueTitle": "Agent ダッシュボード",
  "jev": {
    "mode": "shadow",
    "model": "jev-1.13.0",
    "maxDiffChars": 80000,
    "thresholds": {
      "lowProbability": 0.9,
      "noulSafe": 0.9
    }
  },
  "autoMergeStopLabel": "agent:auto-merge-stopped",
  "classification": {
    "sizes": [
      [
        "XS",
        10
      ],
      [
        "S",
        30
      ],
      [
        "M",
        100
      ],
      [
        "L",
        500
      ],
      [
        "XL",
        1000
      ]
    ],
    "sizeExclude": [
      "package-lock.json",
      "**/*.lock",
      "**/*.snap"
    ],
    "areas": {
      "harness": [
        "harness/**",
        ".github/**",
        ".claude/**",
        "CLAUDE.md",
        "harness.config.json",
        "package.json",
        "tsconfig.json"
      ],
      "docs": [
        "docs/**",
        "README.md"
      ]
    },
    "issueTriage": "shadow"
  }
}
