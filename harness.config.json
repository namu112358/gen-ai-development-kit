{
  "$comment": "導入先ごとの設定。Routine と Actions の両方が既定ブランチのこのファイルを読む。",
  "appSlug": "namu112358-agent-gate",
  "defaultBranch": "main",
  "agentBranchPrefix": "claude/",
  "mergeMethod": "SQUASH",
  "projectChecks": [{ "context": "ci" }],
  "routine": {
    "maxItemsPerRun": 5,
    "humanClaimStaleHours": 6,
    "routineClaimTakeoverMinutes": 90
  },
  "testPatterns": ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**"],
  "guardrailPaths": [
    ".github/**",
    ".claude/settings.json",
    "harness/templates/**",
    ".claude/agents/reviewer.md",
    ".claude/agents/risk-agent.md",
    "docs/risk-policy.md",
    "harness/gates/**",
    "harness/lib/**",
    "harness/scripts/setup.ts",
    "harness/scripts/agent.ts",
    ".claude/skills/judge/SKILL.md",
    ".claude/skills/plan/SKILL.md",
    ".claude/routine.md",
    ".claude/agents/plan-critic.md",
    ".claude/agents/test-designer.md",
    ".claude/skills/sync/SKILL.md",
    ".claude/skills/fix/SKILL.md",
    ".claude/skills/ship/SKILL.md",
    "CLAUDE.md",
    "harness/CLAUDE.harness.md",
    "harness/scripts/report.ts",
    "harness.config.json",
    "package.json",
    "package-lock.json",
    ".node-version",
    "tsconfig.json",
    ".claude/hooks/**",
    ".mcp.json",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    ".claude/agents/review-*.md",
    ".claude/skills/review-panel/SKILL.md",
    "harness/scripts/review-panel.ts"
  ],
  "guardrailExclude": [
    "harness/lib/usage.ts",
    "harness/lib/classify.ts",
    "harness/lib/worktree.ts",
    "harness/lib/issue-triage.ts",
    "harness/lib/queue.ts",
    "harness/lib/concurrency.ts"
  ],
  "areaConcurrency": {
    "harness": 3
  },
  "fixLoop": {
    "normalLimit": 2,
    "criticalLimit": 3
  },
  "staleHours": 24,
  "dashboardIssueTitle": "Agent ダッシュボード",
  "reviewPanel": { "mode": "shadow" },
  "fleet": {
    "nesting": "orca",
    "maxParallelShips": 3,
    "sharedFiles": ["docs/plan.md", "docs/formats.md", "docs/operations.md", "docs/security.md", "docs/glossary.md", "**/README.md"]
  },
  "jev": {
    "mode": "shadow",
    "model": "jev-1.13.0",
    "maxDiffChars": 80000,
    "decisionRelease": "shadow",
    "testTamper": "shadow",
    "thresholds": {
      "lowProbability": 0.9,
      "noulSafe": 0.9,
      "labelProbability": 0.8,
      "labelProbabilityByLabel": { "priority:medium": 0.5 },
      "decisionProbability": 0.9,
      "testTamperProbability": 0.9
    }
  },
  "autoMergeStopLabel": "agent:auto-merge-stopped",
  "humanMergePaths": [],
  "delegate": {
    "planLabel": "agent:delegate-plan",
    "mergeLabel": "agent:delegate-merge"
  },
  "delegateMergeExclude": [
    "harness/lib/merge-route.ts",
    "harness/lib/verdict.ts",
    "harness/lib/config.ts",
    "harness/lib/delegate.ts",
    "harness/gates/**",
    ".github/**",
    "harness.config.json",
    ".claude/settings.json",
    ".claude/hooks/**",
    ".claude/agents/reviewer.md",
    ".claude/agents/risk-agent.md",
    ".claude/skills/judge/SKILL.md",
    "docs/risk-policy.md"
  ],
  "classification": {
    "sizes": [
      [
        "XS",
        10
      ],
      [
        "S",
        30
      ],
      [
        "M",
        100
      ],
      [
        "L",
        500
      ],
      [
        "XL",
        1000
      ]
    ],
    "sizeExclude": [
      "package-lock.json",
      "**/*.lock",
      "**/*.snap"
    ],
    "areas": {
      "harness": [
        "harness/**",
        ".github/**",
        ".claude/**",
        "CLAUDE.md",
        "harness.config.json",
        "package.json",
        "tsconfig.json"
      ],
      "docs": [
        "docs/**",
        "README.md"
      ]
    },
    "issueTriage": "label"
  },
  "pricing": {
    "$comment": "推定料金用の単価（100 万トークンあたり USD）。2026-09 時点の推定値なので、改定されたら更新する。キーはモデル ID（完全一致、無ければ前方一致）。",
    "claude-sonnet-5": { "input": 2, "output": 10, "cacheWrite5m": 2.5, "cacheWrite1h": 4, "cacheRead": 0.2 },
    "claude-opus-5-5": { "input": 4, "output": 20, "cacheWrite5m": 5, "cacheWrite1h": 8, "cacheRead": 0.2 },
    "claude-opus-5": { "input": 5, "output": 25, "cacheWrite5m": 6.25, "cacheWrite1h": 10, "cacheRead": 0.5 },
    "claude-fable-5-1": { "input": 10, "output": 50, "cacheWrite5m": 12.5, "cacheWrite1h": 20, "cacheRead": 0.25 },
    "claude-haiku-4-5": { "input": 1, "output": 5, "cacheWrite5m": 1.25, "cacheWrite1h": 2, "cacheRead": 0.1 }
  }
}
